DATABASE_URL=postgres://crysino:crysino@localhost:5432/crysino
TEST_DATABASE_URL=postgres://crysino:crysino@localhost:5432/crysino_test
REDIS_URL=redis://localhost:6379
PORT=4000

# Secrets: 64 hex chars each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production: keep in a secret manager, never in the repo or the database.
FAIRNESS_KEY=
APP_ENCRYPTION_KEY=

# Website origins allowed to call the API with cookies (comma-separated)
WEB_ORIGINS=http://localhost:3000

# Behind Cloudflare in production: trust its cf-ipcountry / cf-region-code headers
TRUST_CF_GEO_HEADERS=false
# Local development only: treat every visitor as being in this country (must be an allowed region)
DEV_COUNTRY=MT
