{
  "name": "@crysino/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "tsx --env-file=../../.env src/main.ts"
  },
  "dependencies": {
    "@crysino/shared": "workspace:*",
    "@fastify/cookie": "^11",
    "@fastify/cors": "^10",
    "@fastify/rate-limit": "^10",
    "@fastify/websocket": "^11",
    "fastify": "^5",
    "pg": "^8.13.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
